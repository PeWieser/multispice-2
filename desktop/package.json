{
  "name": "multispice-desktop",
  "productName": "MultiSpice",
  "version": "1.0.0",
  "description": "MultiSpice Interactive Circuit Simulator (Frameless Multi-Window Desktop Edition)",
  "author": "MultiSpice Project",
  "main": "main.cjs",
  "private": true,
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.multispice.desktop",
    "productName": "MultiSpice",
    "compression": "store",
    "icon": "icon.png",
    "files": [
      "main.cjs",
      "preload.cjs",
      "icon.png",
      "out/**/*"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}",
      "splashImage": "splash.bmp",
      "unpackDirName": "MultiSpice-1.0.0-Runtime"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
